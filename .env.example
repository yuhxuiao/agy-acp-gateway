# ==============================================================================
# agy-acp-gateway Configuration Template (.env.example)
# Copy to .env (native ./scripts/gw.sh) or deploy/.env (Docker Compose)
# before starting the gateway. Never commit your real .env or API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication, Access Keys & CORS
# ------------------------------------------------------------------------------
# Comma-separated master API keys protecting :18890 (/v1/*, /v1beta/*) and
# :18891 (WebUI Console, /api/*, /metrics).
# - Browser WebUI HTTP Basic Auth accepts ANY username and a master key as password.
# - Supports dynamic routing suffixes: <master_key>@acct:<id> or <master_key>@group:<id>.
# - Per-account and per-group restricted keys (boundKeys) are configured live in :18891
#   and NEVER grant access to the :18891 admin console or /metrics.
# - Leave empty ONLY on trusted local loopback; non-loopback Host headers are rejected (403) when empty.
AGY_API_KEYS=sk-agy-replace-with-your-strong-master-key

# Optional newline-delimited master API keys file (# comments allowed; merged with AGY_API_KEYS)
# AGY_API_KEYS_FILE=/data/api_keys.txt

# Optional comma-separated allowed browser CORS origins for :18890 data-plane API endpoints only
AGY_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 2. Network & Strict Dual-Port Isolation
# ------------------------------------------------------------------------------
# Bind address (127.0.0.1 default on host; deploy/docker-compose.yml sets 0.0.0.0 inside containers)
AGY_LISTEN_HOST=127.0.0.1

# Data-plane API port (:18890 -> /v1/messages, /v1/chat/completions, /v1/responses,
# /v1/images/generations, /v1/images/edits, /v1beta/*, /healthz)
AGY_GW_PORT=18890

# Admin & observability port (:18891 -> WebUI Console /, /api/dashboard, /api/accounts*, /api/upgrade*, /metrics)
AGY_DASH_PORT=18891

# ------------------------------------------------------------------------------
# 3. Multi-Account Pool v3, Egress Proxies & Federated Console (Optional)
# ------------------------------------------------------------------------------
# Display identity for this gateway node / seeded primary account in the WebUI
# (defaults: AGY_INSTANCE_ID=primary, AGY_INSTANCE_LABEL=主实例)
# AGY_INSTANCE_ID=primary
# AGY_INSTANCE_LABEL=Primary Account

# Persistent multi-account & channel-group registry (default: <data_dir>/accounts.json).
# Pool strategy (round-robin | fill-first | weighted-rr | least-load | manual-active),
# account role (primary | standby), governance guardrails (priorityTiering, monitorSpillOnYellow,
# monitorBudgetSpread), pre-stream 1st-turn failover, U8 sticky TTL, channel groups, weights,
# and priorities are all hot-managed in :18891 Account Control Center or /api/accounts/*.
# AGY_ACCOUNTS_FILE=/data/accounts.json

# Optional JSON file defining named egress proxy presets shown in the WebUI dropdown:
# [{"id":"us-west","label":"US West Residential","region":"US","description":"Dedicated static egress"}]
# AGY_PROXY_PRESETS_FILE=/data/proxy-presets.json

# Proxy gateway host and token used to resolve named presets (fails closed if a named preset is selected without token)
# Format resolved at runtime: http://<preset_id>.<account_id>:<token>@<AGY_RESIN_HOST>
# Default AGY_RESIN_HOST in code: resin:2260
# AGY_RESIN_HOST=resin:2260
# AGY_RESIN_PROXY_TOKEN=

# Optional federated multi-node dashboard peers:
# Format: id|label|http://host:18891|apiKey;id2|label2|http://host2:18891
# (If |apiKey is omitted, the local primary master key is used; redirects are never followed.)
# AGY_DASHBOARD_PEERS=

# ------------------------------------------------------------------------------
# 4. Upstream Official agy Binary & Default Egress Proxy
# ------------------------------------------------------------------------------
# Path to the --acp-only patched 900K-context agy binary (default: <project_home>/bin/agy-acp-900k;
# agy 1.5.16 recommended baseline due to upstream agy#1890 in 1.5.17/1.5.18)
# AGY_ACP_BIN=/path/to/agy-acp-gateway/bin/agy-acp-900k

# Optional path to unpatched official agy binary used only for `<agy> -p /usage` quota snapshots
# AGY_QUOTA_BIN=

# Default HTTP/HTTPS/SOCKS5 upstream proxy for the primary account ACP engine.
# - Go binary default when unset/empty: empty (direct egress).
# - Native ./scripts/gw.sh defaults UNSET AGY_UPSTREAM_PROXY to http://127.0.0.1:7890
#   (set AGY_UPSTREAM_PROXY= explicitly for direct egress under gw.sh).
# - In Docker Compose, leave commented out unless using a reachable proxy or per-account presets.
# AGY_UPSTREAM_PROXY=http://127.0.0.1:7890

# Set to 1 to allow consuming Google One AI credits after regular plan quota is exhausted
AGY_USE_G1_CREDITS=0

# ------------------------------------------------------------------------------
# 5. Worker Pool, Concurrency, Resident Memory Governor & Stream Hardening
# ------------------------------------------------------------------------------
# Maximum live `agy acp` stdio sessions in the primary account worker pool
AGY_MAX_LIVE_WORKERS=8

# Container/host-wide live `--worker` cap across ALL accounts (primary + child gateways).
# Set 0 to auto-compute from cgroup memory limit (Go default: 0; deploy/docker-compose.yml: 8).
# Logical resident sessions still scale to 30-50+ via transparent lossless `session/resume`.
AGY_GLOBAL_MAX_LIVE_WORKERS=8

# Maximum concurrent in-flight upstream turns per gateway process.
# Adaptive default when unset: clamp(AGY_MAX_LIVE_WORKERS, 6, 16), live-resizing with primary
# maxLiveWorkers changes in the WebUI; set explicitly to pin and disable live resizing.
# AGY_MAX_CONCURRENT_PROMPTS=8

# Activity-aware session/prompt RPC idle timeout (1800s = 30m default; refreshed on real progress)
# and absolute maximum duration ceiling (43200s = 12h default; clamped >= idle timeout)
AGY_PROMPT_IDLE_TIMEOUT_SEC=1800
AGY_PROMPT_MAX_DURATION_SEC=43200

# Split streaming timeouts (v2.3.22): first-chunk prefill wait (360s = 6m) and post-first-chunk
# inter-chunk stream idle timeout (180s = 3m), paired with cancel resync & blind-EOF abort
AGY_PROMPT_FIRST_CHUNK_TIMEOUT_SEC=360
AGY_PROMPT_STREAM_IDLE_TIMEOUT_SEC=180

# Dedicated worker budget reserved for canary/WAF probes so probes never starve user sessions
AGY_MAX_PROBE_WORKERS=1

# Idle ACP worker hibernation TTL in seconds (180s = 3m default, down from 600s/1200s;
# hibernated sessions rehydrate transparently via `session/resume` without losing context)
AGY_IDLE_WORKER_TTL_SEC=180

# Shared `agy acp` engine idle grace period in seconds before stopping after all live workers hibernate
# (180s = 3m default; keeps engine warm across short gaps; binary-switch restarts stop immediately; 0 = immediate)
AGY_ENGINE_IDLE_GRACE_SEC=180

# Real-time cgroup v2/v1 working-set memory pressure thresholds (%) for proactive cross-account LRU hibernation
AGY_MEM_PRESSURE_WARN_PCT=70
AGY_MEM_PRESSURE_HIGH_PCT=80

# Per-process remote image fetch cache ceiling in MiB (16 MiB default, down from 64 MiB; 0 disables caching)
AGY_IMAGE_CACHE_MAX_MB=16

# Parked MCP tool-call resume TTL in seconds (300s = 5m default)
AGY_PARKED_TTL_SEC=300

# Maximum automatic internal empty-turn (`0/0`) orphan tool-relay hops per request (2 default)
AGY_MAX_TOOL_RELAYS=2

# Parked MCP tool-relay keep-alive interval in seconds (55s default; unless explicitly pinned here or
# via AGY_TOOL_RELAY_MS, adapts by monitor zone & tool class: Green <50% = 55s, Green long-running
# exec tools widen to 80s at >=32K ctx or 135s at <32K ctx, Green >=50% widens to 75s, and
# Yellow/Red widens to 135s base / 150s cap after 30m parked, safely below agy's 180s MCP timeout)
# AGY_TOOL_RELAY_SEC=55

# UTF-8 70/30 head+tail pre-bounding ceiling in bytes for MCP tool_result payloads (9600 default,
# staying safely under agy's 10,240B silent mid-truncation; set 0 to disable)
AGY_MCP_TOOL_RESULT_MAX_BYTES=9600

# Runaway carriage-return (`\r`) output loop guard (aborts after N consecutive `\r` bytes; 4096 default; 0 disables)
AGY_RUNAWAY_CR_MAX_CONSECUTIVE=4096

# Maximum HTTP request body size in MiB
AGY_MAX_BODY_MB=64

# Optional Go runtime & child-account memory ceilings (size container mem_limit accordingly for N accounts):
# GOMEMLIMIT=256MiB
# GOGC=25
# AGY_CHILD_GATEWAY_GOMEMLIMIT=128MiB
# AGY_CHILD_GOMEMLIMIT=180MiB
# AGY_CHILD_GOGC=30

# Optional manual subscription quota tier override for single/primary instance
# (empty = auto-detect via /usage & /credits; valid values: pro | ultra_5x | ultra;
# also configurable per-account persistently via :18891 Account Control Center)
# AGY_ACCOUNT_PLAN_TIER_OVERRIDE=

# ------------------------------------------------------------------------------
# 5b. Safety Monitor Budget Governor v3 (Multi-Account 3-Zone Soft Budget)
# ------------------------------------------------------------------------------
# Route tool-bearing requests away from accounts whose upstream pre-tool safety monitor
# (`sir_flash_lite`) hit a 5h quota lockout (single-account deployments degrade open automatically)
AGY_MONITOR_TRIP_ROUTING=true

# Allow sticky multi-turn tool sessions to hop off a tripped / red-zone account onto a healthy peer
# (cancels/hibernates the old account's parked session locally or via /api/internal/cancel-parked-session;
# zero-tool requests are always exempt)
AGY_MONITOR_TRIP_HOP=true

# Proactively balance new tool-bearing sessions across healthy Green accounts and reverse-route
# zero-tool requests onto Yellow/Red healthy-quota accounts to preserve Green monitor headroom
# (can also be overridden live without restart in :18891 Advanced Routing Guardrails)
AGY_MONITOR_BUDGET_SPREAD=true

# Per-account 5h safety monitor budget thresholds (Monitor Governor v3 `balanced` 88% defaults;
# Green < SOFT_CAP, Yellow soft-drain [SOFT_CAP, DRAIN_CAP), Red >= DRAIN_CAP; presets/custom caps,
# Smart Pacing, and Soft-Red hop are hot-configurable in :18891 and auto-calibrated on real 429 lockouts)
AGY_MONITOR_SOFT_CAP_ULTRA=3300
AGY_MONITOR_DRAIN_CAP_ULTRA=4250
AGY_MONITOR_HARD_CAP_ULTRA=4800
AGY_MONITOR_SOFT_CAP_PRO=2100
AGY_MONITOR_DRAIN_CAP_PRO=2900
AGY_MONITOR_HARD_CAP_PRO=3400

# ------------------------------------------------------------------------------
# 6. Carbon KV Cache Defense & Semantic Cleanroom
# ------------------------------------------------------------------------------
# Prefill Soft-Detach: if a turn has already prefilled for >= MIN_ELAPSED_SEC when the client disconnects,
# keep the upstream turn alive for GRACE_SEC so client retries re-attach via Singleflight without 0% cache loss.
AGY_PREFILL_CANCEL_MIN_ELAPSED_SEC=30
AGY_PREFILL_CANCEL_GRACE_SEC=45

# Emit non-blocking `X-Agy-Cache-Warning` header when >= MIN_TOKENS misses cache for STREAK consecutive turns
AGY_CACHE_WARN_MIN_TOKENS=80000
AGY_CACHE_WARN_STREAK=3

# Cooldown TTL before probing recovery from an automatic lower-tier capacity fallback (300s = 5m default; 0 = sticky for session lifetime)
# Repeated fallbacks on the same session back off exponentially up to MAX_TTL_SEC (1800s = 30m default).
AGY_CAPACITY_FALLBACK_TTL_SEC=300
AGY_CAPACITY_FALLBACK_MAX_TTL_SEC=1800

# Automatically bisect & neutralize upstream 400 WAF false positives via low-cost Flash probes
AGY_WAF_AUTOBISECT=true
# AGY_WAF_RULES_FILE=/data/waf_rewrite_rules.json

# ------------------------------------------------------------------------------
# 7. Model Exposure (11 Chat Models + Image Gen), Multimodal & Media Relay
# ------------------------------------------------------------------------------
# Fallback canonical model when a client omits or sends an unrecognized model name
# AGY_DEFAULT_MODEL=gemini-4-carbon

# Set to 1 to expose explicit `-low` / `-high` / `-xhigh` tier variants in GET /v1/models & /v1beta/models
# (fixed-tier models gpt-oss-120b-medium and gemini-pro-orchestrator* never emit tier suffixes)
# AGY_EXPOSE_TIER_MODELS=0

# Set to 1 to map generic `*opus*` -> claude-opus-5-5, `*sonnet*` -> claude-sonnet-5-5, `*haiku*` -> gemini-3.8-flash
# AGY_ROUTE_CLAUDE_NAMES=0

# Multimodal image & text-document limits:
# - Magic-sniffed PNG/JPEG (incl. grayscale Adobe APP14 strip)/WEBP/GIF/HEIC/HEIF images
# - 24 UTF-8 text/document formats (<=2 MiB)
# - AGY_MAX_IMAGES_CLAUDE applies to 3P models (Claude & GPT-OSS)
AGY_MAX_IMAGES_GEMINI=200
AGY_MAX_IMAGES_CLAUDE=100
AGY_MAX_IMAGE_BYTES=10485760
AGY_MAX_PROMPT_IMAGE_BYTES=33554432
AGY_MAX_TEXT_FILE_BYTES=2097152
AGY_FETCH_IMAGES=true

# Zero-dependency pure-Go PDF text extraction fast-path (1 = enabled by default; handles text PDFs on
# Claude/GPT, tool-bearing turns, or when AGY_MEDIA_RELAY=0 with full tools & Carbon KV cache)
AGY_PDF_TEXT_FASTPATH=1

# Opt-in safe full-multimodal Media Relay (v2.3.23; 0 = disabled by default):
# Set 1 to enable isolated lazy `--agent ws-media` engine inside <PureApiHome>/media-home with
# `"toolPermission": "strict"` synchronous pre-open path whitelist, end-of-turn usage ingest +
# auto-cleanup, and 0 `sir_flash_lite` calls for Gemini native visual PDF, audio, and video.
AGY_MEDIA_RELAY=0

# Per-file decoded size limit in bytes for Media Relay attachments (default 20 MiB = 20971520,
# hard ceiling 25 MiB = 26214400; oversized payloads are rejected pre-decode with HTTP 413)
AGY_MEDIA_RELAY_MAX_BYTES=20971520

# Maximum Media Relay attachments per request (default 3, hard ceiling 5)
AGY_MEDIA_RELAY_MAX_FILES=3

# Global cross-account concurrency semaphore for Media Relay turns (default 1)
AGY_MEDIA_RELAY_MAX_CONCURRENCY=1

# ------------------------------------------------------------------------------
# 8. Storage, Telemetry, Log Hygiene & Host Upgrader
# ------------------------------------------------------------------------------
# Automatic cleanup of gateway-owned conversation files and acp-worker logs older than N days
# (recommended retention in deploy/docker-compose.yml: 4 and 7 days respectively, down from 14;
# Go binary default when unset in native mode is 0 = disabled)
AGY_CONV_KEEP_DAYS=4
AGY_ACP_LOG_KEEP_DAYS=0

# Per-account total size budget in MiB for timestamped acp-worker/acp-front logs (64 MiB default;
# enforces a hard >=24h age protection floor so active/recent logs are never deleted; 0 = disabled)
AGY_ACP_LOG_MAX_MB=64

# Optional read-only Antigravity Desktop App conversations directory for `AGY_APP` dashboard telemetry
# (empty = auto-discover ~/.gemini/antigravity/conversations on local main instance; set "off" to disable)
AGY_APP_CONV_DIR=

# Optional path & rotation overrides (defaults resolve relative to project root or /data in Docker):
# AGY_STATE_DB=/data/gateway.db
# AGY_GW_LOG=/data/logs/gateway.log
# AGY_LOG_MAX_MB=20
# AGY_UPGRADE_DIR=/data/upgrade

# Optional host-side prod-upgrader (`deploy/prod-upgrader/agy_prod_upgrader.py`) backoff schedule in seconds
# for `verify_deferred` post-switch quota retries (comma-separated; default: 900,1800,3600 = 15m/30m/60m)
# AGY_VERIFY_DEFER_BACKOFF_SECS=900,1800,3600

# Optional host-side prod-upgrader known-regression agy version blocklist (comma-separated "<ver>" or
# "<ver>:<reason>"; defaults to blocking 1.5.17,1.5.18 for agy#1890 --agent 4x Gemini quota burn & agy#1872;
# set empty "" or "none" to disable and allow operator override)
# AGY_BLOCKED_VERSIONS=1.5.17,1.5.18

# Host upgrader (`deploy/prod-upgrader` / `scripts/agy_upgrade.py`) G5a offline 0-quota media strict-permission check
# (0 = strictly enforced by default before promoting any future agy update; set 1 ONLY on the host for emergency override)
# AGY_SKIP_G5_MEDIA_CHECK=0
