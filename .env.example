# ==============================================================================
# agy-acp-gateway Configuration Template (.env.example)
# Copy to .env (for ./scripts/gw.sh) or deploy/.env (for Docker Compose).
# Never commit your real .env file or API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication, API Keys & CORS
# ------------------------------------------------------------------------------
# Comma-separated master API keys protecting both :18890 (AI APIs) and :18891 (Web console, /api/*, /metrics).
# - For browser login to :18891, enter any username and a master key as password.
# - Append @acct:<id> or @group:<id> to a master key to target one account or group.
# - Restricted per-account and per-group keys (boundKeys) are managed in :18891 and
#   cannot access the :18891 admin console or /metrics.
# - Leave empty only for local loopback use; non-loopback Host headers return 403 when empty.
AGY_API_KEYS=sk-agy-replace-with-your-strong-master-key

# Optional newline-delimited file of extra master keys (# comments allowed; merged with AGY_API_KEYS)
# AGY_API_KEYS_FILE=/data/api_keys.txt

# Optional comma-separated allowed browser CORS origins (applies to :18890 API endpoints only)
AGY_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 2. Ports & Network Binding
# ------------------------------------------------------------------------------
# Listen address (127.0.0.1 default on host; deploy/docker-compose.yml sets 0.0.0.0 inside containers)
AGY_LISTEN_HOST=127.0.0.1

# Data-plane AI API port (:18890 -> /v1/messages, /v1/chat/completions, /v1/responses,
# /v1/images/generations, /v1/images/edits, /v1beta/*, /healthz)
AGY_GW_PORT=18890

# Admin console and metrics port (:18891 -> /, /api/dashboard, /api/accounts*, /api/upgrade*, /metrics)
AGY_DASH_PORT=18891

# ------------------------------------------------------------------------------
# 3. Multi-Account Pool, Egress Proxies & Multi-Node Console (Optional)
# ------------------------------------------------------------------------------
# Display ID and label for the primary gateway node in :18891
# (defaults: AGY_INSTANCE_ID=primary, AGY_INSTANCE_LABEL=主实例)
# AGY_INSTANCE_ID=primary
# AGY_INSTANCE_LABEL=Primary Account

# Path to accounts and channel-groups config JSON (default: <data_dir>/accounts.json).
# Routing strategy, primary/standby roles, failover, per-account allowlists, and
# channel groups can be edited live in :18891 without restarting.
# AGY_ACCOUNTS_FILE=/data/accounts.json

# Optional JSON file listing named egress proxy presets shown in the :18891 dropdown:
# [{"id":"us-west","label":"US West","region":"US","description":"Dedicated static IP"}]
# AGY_PROXY_PRESETS_FILE=/data/proxy-presets.json

# Proxy relay host and token for named presets (fails closed if a preset is selected without token).
# Resolved proxy URL: http://<preset_id>.<account_id>:<token>@<AGY_RESIN_HOST>
# AGY_RESIN_HOST=resin:2260
# AGY_RESIN_PROXY_TOKEN=

# Optional remote gateway nodes shown in the same :18891 console:
# Format: id|label|http://host:18891|apiKey;id2|label2|http://host2:18891
# (If |apiKey is omitted, the local master key is used; HTTP redirects are never followed.)
# AGY_DASHBOARD_PEERS=

# ------------------------------------------------------------------------------
# 4. Official agy Binary & Default Upstream Proxy
# ------------------------------------------------------------------------------
# Path to the --acp-only patched 900K-context agy binary (default: <project_home>/bin/agy-acp-900k).
# Recommended upstream baseline: agy 1.5.16 (1.5.17/1.5.18 have a known 4x quota burn bug in --agent mode).
# AGY_ACP_BIN=/path/to/agy-acp-gateway/bin/agy-acp-900k

# Optional path to unpatched official agy binary used only for `<agy> -p /usage` quota checks
# AGY_QUOTA_BIN=

# Default HTTP/HTTPS/SOCKS5 upstream proxy for the primary account.
# - Go binary default when unset: empty (direct connection).
# - ./scripts/gw.sh defaults an unset value to http://127.0.0.1:7890
#   (set AGY_UPSTREAM_PROXY= explicitly for direct connection under gw.sh).
# - In Docker Compose, leave commented out unless your container can reach the proxy.
# AGY_UPSTREAM_PROXY=http://127.0.0.1:7890

# Set to 1 to allow using Google One AI credits after plan quota runs out
AGY_USE_G1_CREDITS=0

# ------------------------------------------------------------------------------
# 5. Worker Concurrency, Dual-Layer Memory Limits & Stream Timeouts
# ------------------------------------------------------------------------------
# Max concurrent worker processes allowed for the primary account
AGY_MAX_LIVE_WORKERS=8

# Global worker process cap across ALL accounts (primary + secondary accounts).
# Set 0 to calculate automatically from container/host memory limit.
# In v2.3.26+, dual-layer memory control separates idle retention from burst concurrency:
# - AGY_GLOBAL_IDLE_TARGET (falls back to AGY_GLOBAL_MAX_LIVE_WORKERS): target hot workers kept when idle (default 8)
# - AGY_GLOBAL_BURST_MAX_LIVE_WORKERS: hard ceiling during traffic bursts; 0 = auto-derive from container/host RAM
#   (e.g. 8 on the default 3.2 GB container, 18 on a 6 GB container) to prevent OOM on smaller mem_limit deployments.
# Hibernated conversations resume via `session/resume` without losing prompt cache.
AGY_GLOBAL_MAX_LIVE_WORKERS=8
AGY_GLOBAL_IDLE_TARGET=8
AGY_GLOBAL_BURST_MAX_LIVE_WORKERS=0

# Max concurrent in-flight prompts per gateway process.
# When unset, follows clamp(AGY_MAX_LIVE_WORKERS, 6, 16) and updates live with WebUI edits.
# AGY_MAX_CONCURRENT_PROMPTS=8

# Activity-aware session/prompt idle timeout (1800s = 30m) and absolute ceiling (43200s = 12h)
AGY_PROMPT_IDLE_TIMEOUT_SEC=1800
AGY_PROMPT_MAX_DURATION_SEC=43200

# Split streaming timeouts: wait for first chunk (360s = 6m) and gap between chunks (180s = 3m)
AGY_PROMPT_FIRST_CHUNK_TIMEOUT_SEC=360
AGY_PROMPT_STREAM_IDLE_TIMEOUT_SEC=180

# Worker slots reserved for health/WAF probes so probes do not starve user requests
AGY_MAX_PROBE_WORKERS=1

# Idle worker hibernation timeout in seconds (180s = 3m default).
# Hibernated sessions reload cleanly via `session/resume` on the next turn.
AGY_IDLE_WORKER_TTL_SEC=180

# Seconds to keep the shared `agy acp` process warm after all workers hibernate (180s default; 0 = stop at once)
AGY_ENGINE_IDLE_GRACE_SEC=180

# Container cgroup v2/v1 working-set RAM pressure thresholds (%) that trigger cross-account LRU hibernation
AGY_MEM_PRESSURE_WARN_PCT=70
AGY_MEM_PRESSURE_HIGH_PCT=80

# Max in-memory cache for fetched remote images per process in MiB (16 MiB default; 0 disables)
AGY_IMAGE_CACHE_MAX_MB=16

# Timeout in seconds for waiting on a client MCP tool result before releasing a parked call (300s = 5m)
AGY_PARKED_TTL_SEC=300

# Max automatic empty-turn (0/0) tool-relay hops per request (2 default)
AGY_MAX_TOOL_RELAYS=2

# Parked MCP tool keep-alive interval in seconds (55s default; adapts from 55s to 150s when unset
# based on tool type and 5h safety-check pressure, staying under agy's 180s MCP timeout)
# AGY_TOOL_RELAY_SEC=55

# Max bytes for MCP tool_result text before 70/30 head+tail trimming (9600 default,
# staying below agy's 10,240B silent mid-truncation; 0 disables)
AGY_MCP_TOOL_RESULT_MAX_BYTES=9600

# Abort output if a model emits N consecutive carriage-return (\r) bytes (4096 default; 0 disables)
AGY_RUNAWAY_CR_MAX_CONSECUTIVE=4096

# Max HTTP request body size in MiB
AGY_MAX_BODY_MB=64

# Optional Go runtime memory ceilings (v2.3.26 slim defaults shown below):
# GOMEMLIMIT=256MiB
# GOGC=25
# AGY_CHILD_GATEWAY_GOMEMLIMIT=80MiB
# AGY_CHILD_GOMEMLIMIT=150MiB
# AGY_CHILD_GOGC=25

# Optional manual quota tier override for the primary account (empty = auto-detect;
# valid values: pro | ultra_5x | ultra; also editable per account in :18891)
# AGY_ACCOUNT_PLAN_TIER_OVERRIDE=

# ------------------------------------------------------------------------------
# 6. 5-Hour Tool Safety Check Limits (Multi-Account Protection)
# ------------------------------------------------------------------------------
# Avoid accounts whose 5h pre-tool safety check (`sir_flash_lite`) hit a 429 limit
# (single-account setups stay open automatically)
AGY_MONITOR_TRIP_ROUTING=true

# Allow active tool conversations to move off a 429-limited account to a healthy account
# (cancels the old account's parked session; plain text requests are always unaffected)
AGY_MONITOR_TRIP_HOP=true

# Balance new tool conversations across accounts with more remaining 5h safety checks,
# and send zero-tool requests to busier accounts to save safety-check headroom
AGY_MONITOR_BUDGET_SPREAD=true

# Default 5h tool safety check thresholds (balanced 88% preset: soft spill / stop new tool turns / hard cap).
# You can switch presets (80% / 88% / 93% / custom) live in :18891 without restarting.
AGY_MONITOR_SOFT_CAP_ULTRA=3300
AGY_MONITOR_DRAIN_CAP_ULTRA=4250
AGY_MONITOR_HARD_CAP_ULTRA=4800
AGY_MONITOR_SOFT_CAP_PRO=2100
AGY_MONITOR_DRAIN_CAP_PRO=2900
AGY_MONITOR_HARD_CAP_PRO=3400

# ------------------------------------------------------------------------------
# 7. Prompt Cache Protection & WAF Auto-Recovery
# ------------------------------------------------------------------------------
# Slow prefill rescue: if a request has been prefilling for >= MIN_ELAPSED_SEC when the client disconnects,
# keep the upstream request running for GRACE_SEC so client retries re-attach without losing prompt cache.
AGY_PREFILL_CANCEL_MIN_ELAPSED_SEC=30
AGY_PREFILL_CANCEL_GRACE_SEC=45

# Send X-Agy-Cache-Warning header if >= MIN_TOKENS misses cache for STREAK consecutive turns
AGY_CACHE_WARN_MIN_TOKENS=80000
AGY_CACHE_WARN_STREAK=3

# Cooldown seconds before probing recovery after an automatic thinking-tier downgrade (300s default; 0 = keep for session)
# Repeated downgrades on the same session back off up to MAX_TTL_SEC (1800s default).
AGY_CAPACITY_FALLBACK_TTL_SEC=300
AGY_CAPACITY_FALLBACK_MAX_TTL_SEC=1800

# Automatically bisect upstream 400 WAF false positives with Flash probes and save minimal rewrite rules
AGY_WAF_AUTOBISECT=true
# AGY_WAF_RULES_FILE=/data/waf_rewrite_rules.json

# ------------------------------------------------------------------------------
# 8. Models (11 Chat + 1 Image Gen), PDF & Media Relay
# ------------------------------------------------------------------------------
# Fallback model when a client omits or sends an unknown model name
# AGY_DEFAULT_MODEL=gemini-4-carbon

# Set to 1 to list -low / -high / -xhigh variants in GET /v1/models and /v1beta/models
# (fixed-tier models gpt-oss-120b-medium and gemini-pro-orchestrator* never add tier suffixes)
# AGY_EXPOSE_TIER_MODELS=0

# Set to 1 to map *opus* -> claude-opus-5-5, *sonnet* -> claude-sonnet-5-5, *haiku* -> gemini-3.8-flash
# AGY_ROUTE_CLAUDE_NAMES=0

# Image and text attachment limits (AGY_MAX_IMAGES_CLAUDE applies to Claude and GPT-OSS):
# Supports magic-checked PNG, JPEG, WEBP, GIF, HEIC, HEIF and 24 UTF-8 text formats (<= 2 MiB)
AGY_MAX_IMAGES_GEMINI=200
AGY_MAX_IMAGES_CLAUDE=100
AGY_MAX_IMAGE_BYTES=10485760
AGY_MAX_PROMPT_IMAGE_BYTES=33554432
AGY_MAX_TEXT_FILE_BYTES=2097152
AGY_FETCH_IMAGES=true

# Built-in pure-Go text PDF extractor (1 = enabled by default; works on all models including Claude/GPT
# and tool turns while keeping prompt cache intact)
AGY_PDF_TEXT_FASTPATH=1

# Opt-in isolated media sandbox for Gemini native visual/scanned PDF, audio, and video (0 = off by default).
# When 1, launches an isolated `--agent ws-media` process under <PureApiHome>/media-home with
# `"toolPermission": "strict"` per-file path allowlisting and 0 safety-monitor calls.
AGY_MEDIA_RELAY=0

# Max decoded file size in bytes for Media Relay attachments (default 20 MiB = 20971520,
# hard limit 25 MiB = 26214400; oversized payloads return HTTP 413 before decoding)
AGY_MEDIA_RELAY_MAX_BYTES=20971520

# Max attachments per Media Relay request (default 3, hard limit 5)
AGY_MEDIA_RELAY_MAX_FILES=3

# Max concurrent Media Relay turns across all accounts (default 1)
AGY_MEDIA_RELAY_MAX_CONCURRENCY=1

# ------------------------------------------------------------------------------
# 9. Storage Cleanup, Logs & Host Upgrader
# ------------------------------------------------------------------------------
# Delete gateway-owned conversation files and acp-worker logs older than N days
# (deploy/docker-compose.yml sets 4 and 7 days; Go default when unset is 0 = keep all)
AGY_CONV_KEEP_DAYS=4
AGY_ACP_LOG_KEEP_DAYS=0

# Max total size in MiB for timestamped acp-worker/acp-front logs per account (64 MiB default;
# logs newer than 24h are always kept; 0 disables)
AGY_ACP_LOG_MAX_MB=64

# Optional read-only path to Antigravity Desktop App conversations for dashboard stats
# (empty = auto-detect ~/.gemini/antigravity/conversations on local main host; set "off" to disable)
AGY_APP_CONV_DIR=

# Optional file path and log size overrides:
# AGY_STATE_DB=/data/gateway.db
# AGY_GW_LOG=/data/logs/gateway.log
# AGY_LOG_MAX_MB=20
# AGY_UPGRADE_DIR=/data/upgrade

# Optional host upgrader (`deploy/prod-upgrader/agy_prod_upgrader.py`) retry delays in seconds
# when post-switch checks hit pool-wide 429 (default: 900,1800,3600 = 15m/30m/60m)
# AGY_VERIFY_DEFER_BACKOFF_SECS=900,1800,3600

# Optional host upgrader blocklist for upstream agy versions with known regressions
# (default blocks 1.5.17,1.5.18 due to --agent 4x quota burn; set "" or "none" to allow)
# AGY_BLOCKED_VERSIONS=1.5.17,1.5.18

# Host upgrader offline binary check confirming `ws-media` strict permission order
# (0 = enforced before promoting any agy upgrade; set 1 only on host for emergency override)
# AGY_SKIP_G5_MEDIA_CHECK=0
