# ==============================================================================
# agy-acp-gateway Configuration Example (.env.example)
# Copy to .env and adjust values before starting the gateway or Docker container.
# ==============================================================================

# --- Authentication & Security ---
# Comma-separated API keys for /v1/* endpoints (leave empty ONLY on trusted localhost)
AGY_API_KEYS=sk-agy-replace-with-your-secret-key
# Optional separate token for Dashboard & /metrics (falls back to AGY_API_KEYS if unset)
AGY_DASH_TOKEN=
# Optional Basic Auth password for the browser dashboard
AGY_DASH_PASS=
# Optional comma-separated allowed CORS origins
AGY_CORS_ORIGINS=

# --- Network & Ports ---
AGY_LISTEN_HOST=127.0.0.1
AGY_GW_PORT=18890
AGY_DASH_PORT=18891

# --- Upstream ACP Binary & Proxy ---
# Path to the patched 900K context agy binary (default: <project_root>/bin/agy-acp-900k)
# AGY_ACP_BIN=/path/to/agy-acp-gateway/bin/agy-acp-900k
# Upstream HTTP/HTTPS proxy used by the agy ACP subprocess (set empty if direct connection)
AGY_UPSTREAM_PROXY=http://127.0.0.1:7890
# Set to 1 to allow consuming Google One AI credits when regular quota is exhausted
AGY_USE_G1_CREDITS=0

# --- Worker Pool & Session Lifecycle ---
AGY_MAX_LIVE_WORKERS=8
AGY_MAX_CONCURRENT_PROMPTS=6
AGY_IDLE_WORKER_TTL_SEC=360
AGY_PARKED_TTL_SEC=1800
AGY_MAX_BODY_MB=64
