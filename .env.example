# ==============================================================================
# agy-acp-gateway Configuration Template (.env.example)
# Copy to .env (native ./scripts/gw.sh) or deploy/.env (Docker Compose)
# before starting the gateway. Never commit your real .env or API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication, Access Keys & CORS
# ------------------------------------------------------------------------------
# Comma-separated master API keys protecting :18890 (/v1/*, /v1beta/*) and
# :18891 (WebUI Console, /api/*, /metrics).
# - Browser WebUI HTTP Basic Auth accepts ANY username and a master key as password.
# - Supports dynamic routing suffixes: <master_key>@acct:<id> or <master_key>@group:<id>.
# - Per-account and per-group restricted keys (boundKeys) are configured live in :18891
#   and NEVER grant access to the :18891 admin console or /metrics.
# - Leave empty ONLY on trusted local loopback; non-loopback Host headers are rejected (403) when empty.
AGY_API_KEYS=sk-agy-replace-with-your-strong-master-key

# Optional newline-delimited master API keys file (# comments allowed; merged with AGY_API_KEYS)
# AGY_API_KEYS_FILE=/data/api_keys.txt

# Optional comma-separated allowed browser CORS origins for :18890 API endpoints
AGY_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 2. Network & Strict Dual-Port Isolation
# ------------------------------------------------------------------------------
# Bind address (127.0.0.1 recommended on host; set 0.0.0.0 inside Docker containers)
AGY_LISTEN_HOST=127.0.0.1

# Data-plane API port (:18890 -> /v1/messages, /v1/chat/completions, /v1/responses, /v1beta/*, /healthz)
AGY_GW_PORT=18890

# Admin & observability port (:18891 -> WebUI Console /, /api/dashboard, /api/accounts*, /metrics)
AGY_DASH_PORT=18891

# ------------------------------------------------------------------------------
# 3. Multi-Account Pool, Egress Proxies & Federated Console (Optional)
# ------------------------------------------------------------------------------
# Display identity for this gateway node / seeded primary account in the WebUI
# AGY_INSTANCE_ID=primary
# AGY_INSTANCE_LABEL=Primary Account

# Persistent multi-account & channel-group registry (default: <data_dir>/accounts.json).
# Routing strategy (round-robin | fill-first | weighted-rr | least-load | manual-active),
# pre-stream 1st-turn failover, U8 sticky TTL, account groups, weights, and priorities
# are all hot-managed in the :18891 Account Control Center or via /api/accounts/*.
# AGY_ACCOUNTS_FILE=/data/accounts.json

# Optional JSON file defining named egress proxy presets shown in the WebUI dropdown:
# [{"id":"us-west","label":"US West Residential","region":"US","description":"Dedicated static egress"}]
# AGY_PROXY_PRESETS_FILE=/data/proxy-presets.json

# Proxy gateway host and token used to resolve named presets (fails closed if a named preset is selected without token)
# Format resolved at runtime: http://<preset_id>.<account_id>:<token>@<AGY_RESIN_HOST>
# AGY_RESIN_HOST=proxy.example.internal:2260
# AGY_RESIN_PROXY_TOKEN=

# Optional federated multi-node dashboard peers:
# Format: id|label|http://host:18891|apiKey;id2|label2|http://host2:18891
# (If |apiKey is omitted, the local primary master key is used; redirects are never followed.)
# AGY_DASHBOARD_PEERS=

# ------------------------------------------------------------------------------
# 4. Upstream Official agy Binary & Default Egress Proxy
# ------------------------------------------------------------------------------
# Path to the Gate 1-5 patched 900K-context agy binary (default: <repo_root>/bin/agy-acp-900k)
# AGY_ACP_BIN=/path/to/agy-acp-gateway/bin/agy-acp-900k

# Optional path to unpatched official agy binary used only for `<agy> -p /usage` quota snapshots
# AGY_QUOTA_BIN=

# Default HTTP/HTTPS/SOCKS5 upstream proxy for the primary account ACP engine (leave empty for direct egress)
# Uncomment if routing primary agy through a local HTTP/SOCKS5 proxy (in Docker, use host.docker.internal or per-account presets)
# AGY_UPSTREAM_PROXY=http://127.0.0.1:7890

# Set to 1 to allow consuming Google One AI credits after regular plan quota is exhausted
AGY_USE_G1_CREDITS=0

# ------------------------------------------------------------------------------
# 5. Worker Pool, Concurrency & Memory Tuning
# ------------------------------------------------------------------------------
# Maximum live `agy acp` stdio worker processes in the primary account pool
AGY_MAX_LIVE_WORKERS=8

# Maximum concurrent in-flight upstream turns per gateway process.
# Adaptive default when unset: clamp(AGY_MAX_LIVE_WORKERS, 6, 16), live-resizing with primary
# maxLiveWorkers changes in the WebUI; set explicitly to pin and disable live resizing.
# AGY_MAX_CONCURRENT_PROMPTS=8

# Activity-aware session/prompt RPC idle timeout (1800s = 30m default; refreshed on real progress)
# and absolute maximum duration ceiling (43200s = 12h default; clamped >= idle timeout)
AGY_PROMPT_IDLE_TIMEOUT_SEC=1800
AGY_PROMPT_MAX_DURATION_SEC=43200

# Dedicated worker budget reserved for canary/WAF probes so probes never starve user sessions
AGY_MAX_PROBE_WORKERS=1

# Idle ACP worker hibernation TTL in seconds (1200s = 20m default; preserves warm sessions)
AGY_IDLE_WORKER_TTL_SEC=1200

# Parked MCP tool-call resume TTL in seconds (300s = 5m default)
AGY_PARKED_TTL_SEC=300

# Maximum automatic internal empty-turn (`0/0`) orphan tool-relay hops per request (2 default)
AGY_MAX_TOOL_RELAYS=2

# Parked MCP tool-relay keep-alive interval in seconds (55s default; widens adaptively to 75s at >=50%
# monitor utilization unless explicitly pinned here)
# AGY_TOOL_RELAY_SEC=55

# Maximum HTTP request body size in MiB
AGY_MAX_BODY_MB=64

# Optional Go runtime & child-account memory ceilings (size container mem_limit accordingly for N accounts):
# GOMEMLIMIT=256MiB
# GOGC=25
# AGY_CHILD_GATEWAY_GOMEMLIMIT=128MiB
# AGY_CHILD_GOMEMLIMIT=180MiB

# ------------------------------------------------------------------------------
# 5b. Safety Monitor Budget Governor v2 (Multi-Account 3-Zone Soft Budget)
# ------------------------------------------------------------------------------
# Route tool-bearing requests away from accounts whose upstream pre-tool safety monitor
# (`sir_flash_lite`) hit a 5h quota lockout (single-account deployments degrade open automatically)
AGY_MONITOR_TRIP_ROUTING=true

# Allow sticky multi-turn tool sessions to hop off a tripped / red-zone account onto a healthy peer
# (automatically cancels/hibernates the old account's parked session; zero-tool requests are always exempt)
AGY_MONITOR_TRIP_HOP=true

# Proactively spread new tool-bearing sessions across healthy Green accounts and reverse-route
# zero-tool requests onto Yellow/Red healthy-quota accounts to preserve Green monitor headroom
AGY_MONITOR_BUDGET_SPREAD=true

# Per-account 5h safety monitor budget thresholds (Green < SOFT_CAP, Yellow soft-drain [SOFT_CAP, DRAIN_CAP),
# Red >= DRAIN_CAP; auto-calibrated proportionally on real 429 lockouts and persisted in monitor-trips.json)
AGY_MONITOR_SOFT_CAP_ULTRA=2800
AGY_MONITOR_DRAIN_CAP_ULTRA=3800
AGY_MONITOR_HARD_CAP_ULTRA=4800
AGY_MONITOR_SOFT_CAP_PRO=1800
AGY_MONITOR_DRAIN_CAP_PRO=2600
AGY_MONITOR_HARD_CAP_PRO=3400

# ------------------------------------------------------------------------------
# 6. Carbon KV Cache Defense & Semantic Cleanroom
# ------------------------------------------------------------------------------
# Prefill Soft-Detach: if a turn has already prefilled for >= MIN_ELAPSED_SEC when the client disconnects,
# keep the upstream turn alive for GRACE_SEC so client retries re-attach via Singleflight without 0% cache loss.
AGY_PREFILL_CANCEL_MIN_ELAPSED_SEC=30
AGY_PREFILL_CANCEL_GRACE_SEC=45

# Emit non-blocking `X-Agy-Cache-Warning` header when >= MIN_TOKENS misses cache for STREAK consecutive turns
AGY_CACHE_WARN_MIN_TOKENS=80000
AGY_CACHE_WARN_STREAK=3

# Cooldown TTL before probing recovery from an automatic lower-tier capacity fallback (300s = 5m default; 0 = sticky for session lifetime)
# Repeated fallbacks on the same session back off exponentially up to MAX_TTL_SEC (1800s = 30m default).
AGY_CAPACITY_FALLBACK_TTL_SEC=300
AGY_CAPACITY_FALLBACK_MAX_TTL_SEC=1800

# Automatically bisect & neutralize upstream 400 WAF false positives via low-cost Flash probes
AGY_WAF_AUTOBISECT=true
# AGY_WAF_RULES_FILE=/data/waf_rewrite_rules.json

# ------------------------------------------------------------------------------
# 7. Model Exposure, Routing Aliases & Multimodal Pipeline
# ------------------------------------------------------------------------------
# Fallback canonical model when a client omits or sends an unrecognized model name
# AGY_DEFAULT_MODEL=gemini-4-carbon

# Set to 1 to expose explicit `-low` / `-high` / `-xhigh` tier variants in GET /v1/models & /v1beta/models
# AGY_EXPOSE_TIER_MODELS=0

# Set to 1 to map generic `*opus*` -> claude-opus-5-5, `*sonnet*` -> claude-sonnet-5-5, `*haiku*` -> gemini-3.8-flash
# AGY_ROUTE_CLAUDE_NAMES=0

# Multimodal image/text attachment limits & SSRF-guarded remote image fetching
AGY_MAX_IMAGES_GEMINI=200
AGY_MAX_IMAGES_CLAUDE=100
AGY_MAX_IMAGE_BYTES=10485760
AGY_MAX_PROMPT_IMAGE_BYTES=33554432
AGY_MAX_TEXT_FILE_BYTES=2097152
AGY_FETCH_IMAGES=true

# ------------------------------------------------------------------------------
# 8. Storage, Telemetry & Lifecycle Maintenance
# ------------------------------------------------------------------------------
# Optional automatic cleanup of gateway-owned conversation files and acp-worker logs older than N days
# (0 = disabled by default in native mode; deploy/docker-compose.yml defaults to 14 and 7 respectively)
AGY_CONV_KEEP_DAYS=0
AGY_ACP_LOG_KEEP_DAYS=0

# Optional read-only Antigravity Desktop App conversations directory for `AGY_APP` dashboard telemetry
# (empty = auto-discover ~/.gemini/antigravity/conversations on local main instance; set "off" to disable)
AGY_APP_CONV_DIR=

# Optional path overrides (defaults resolve relative to project root or /data in Docker):
# AGY_STATE_DB=/data/gateway.db
# AGY_GW_LOG=/data/logs/gateway.log
# AGY_LOG_MAX_MB=20
# AGY_UPGRADE_DIR=/data/upgrade

# Optional host-side prod-upgrader (`deploy/prod-upgrader/agy_prod_upgrader.py`) backoff schedule in seconds
# for `verify_deferred` post-switch quota retries (comma-separated; default: 900,1800,3600 = 15m/30m/60m)
# AGY_VERIFY_DEFER_BACKOFF_SECS=900,1800,3600
